# Optional weekly player-prop feed. Keep keys server-side; never use NEXT_PUBLIC_.
PROPLINE_API_KEY=

# Broad US-book game-line comparison (moneyline, spread, and total).
ODDS_API_KEY=

# Weekly player props and game lines from every book enabled on the account.
ODDS_IO_API_KEY=

# Optional comma-separated override. By default the app discovers the books
# selected on the provider account; if discovery fails it requests active NY books.
ODDS_IO_BOOKMAKERS=

# Optional DraftKings sportsbook jurisdiction for the direct season feed.
# Defaults to New York, matching the site's current personal-use setup.
DRAFTKINGS_SITE=dkusny

# Optional comma-separated, licensed JSON endpoints for additional season-long
# player totals. Feeds must use The Odds API-compatible bookmaker/market shapes.
LIVE_SEASON_FEED_URLS=
LIVE_SEASON_FEED_BEARER_TOKEN=

# Durable historical capture. Keep the service-role key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random secret required by the scheduled capture endpoint.
CRON_SECRET=
